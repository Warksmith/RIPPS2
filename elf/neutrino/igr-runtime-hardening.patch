diff --git a/ee/loader/src/modlist.c b/ee/loader/src/modlist.c
index cf4fb20..256acef 100644
--- a/ee/loader/src/modlist.c
+++ b/ee/loader/src/modlist.c
@@ -4,6 +4,7 @@
 #include <string.h>
 #include <fcntl.h>
 #include <unistd.h>
+#include <errno.h>
 
 // PS2SDK
 #include <loadfile.h>
@@ -44,14 +45,33 @@ int module_load(struct SModule *mod)
 
     // Get module size
     mod->iSize = lseek(fd, 0, SEEK_END);
-    lseek(fd, 0, SEEK_SET);
+    if (mod->iSize <= 0 || lseek(fd, 0, SEEK_SET) < 0)
+        goto load_failed;
 
     // Allocate memory and load module
     mod->pData = malloc(mod->iSize); // NOTE: never freed, but we don't care
-    read(fd, mod->pData, mod->iSize);
+    if (mod->pData == NULL)
+        goto load_failed;
+    off_t loaded = 0;
+    while (loaded < mod->iSize) {
+        ssize_t count = read(fd, (char *)mod->pData + loaded, mod->iSize - loaded);
+        if (count < 0 && errno == EINTR)
+            continue;
+        if (count <= 0)
+            goto load_failed;
+        loaded += count;
+    }
     close(fd);
 
     return 0;
+
+load_failed:
+    printf("ERROR: Could not read complete module %s\n", mod->sFileName);
+    close(fd);
+    free(mod->pData);
+    mod->pData = NULL;
+    mod->iSize = 0;
+    return -1;
 }
 
