@@ -143,6 +163,19 @@ void *module_get_settings(struct SModule *mod)
     return settings;
 }
 
+struct ee_core_data *module_get_eecore_settings(struct SModule *mod)
+{
+    if (mod == NULL || mod->pData == NULL)
+        return NULL;
+    for (off_t i = 0; i + (off_t)sizeof(struct ee_core_data) <= mod->iSize; i += 4) {
+        struct ee_core_data *settings = (void *)((char *)mod->pData + i);
+        if (settings->magic == EECORE_SETTINGS_MAGIC &&
+            settings->SettingsSize == sizeof(*settings))
+            return settings;
+    }
+    return NULL;
+}
