 static char gNeutrinoArgs[256];
 static char gExitPath[256];
+static const char *ripps2ExitPath(char *p, int n) { (void)p; (void)n; return "Browser"; }
 #define COMPAT_MODE_6 32
 static int ripps2GetBootPath(char *p, int n) { snprintf(p, n, "mmce0:/RIPPS2.ELF"); return 1; }
 static int mmceGameIDSlot(int mask) { return (mask & 1) ? -1 : 0; }
diff --git a/src/ripps2boot.c b/src/ripps2boot.c
index f3fbab3..86ae58f 100644
--- a/src/ripps2boot.c
+++ b/src/ripps2boot.c
@@ -822,9 +822,39 @@ int ripps2BootLockIgrPath(char *out, int size)
 // itself was at mc0:/RIPPS2/RIPPS2.ELF (10/25). That is checked while the boot card is in (after the settings load,
 // and when the IGR Path is set), never at a launch: an SD2PSX may have switched to the game's own card by then.
 static int exitStale = 0;
+// Optional plain-ELF boot-loader bridge. Cache it while the boot card is still
+// selected: probing mcN: after GameID would inspect the game's save card.
+static char igrBootLoader[32];
+
+static void igrFindBootLoader(void)
+{
+    unsigned char head[52];
+    char path[32];
+    int port, fd, n;
+
+    igrBootLoader[0] = '\0';
+    if (gExitPath[0])
+        return; // an explicit path, including Browser, takes precedence
+    for (port = 0; port < 2; port++) {
+        snprintf(path, sizeof(path), "mc%d:/RIPPS2/IGR.ELF", port);
+        if ((fd = open(path, O_RDONLY)) < 0)
+            continue;
+        n = read(fd, head, sizeof(head));
+        close(fd);
+        // ELF32, little-endian, executable, MIPS. A bound BIBLE KELF cannot
+        // be passed to the engines' plain SifLoadElf return path.
+        if (n == (int)sizeof(head) && !memcmp(head, "\177ELF\1\1\1", 7) &&
+            head[16] == 2 && head[17] == 0 && head[18] == 8 && head[19] == 0) {
+            snprintf(igrBootLoader, sizeof(igrBootLoader), "%s", path);
+            break;
+        }
+    }
+}
 
 void ripps2ExitPathCheck(void)
 {
+    igrFindBootLoader();
+    ripps2Diag("IGR: default return %s", igrBootLoader[0] ? igrBootLoader : "Browser");
     // build 116: opened, not stat()ed: stat() on a memory card says yes for a path that is not there (blFileExists), so
     // build 115 never caught the stale path it was written for (lab, 10/27: STATUS showed EXIT: mc1:/APPS/RIPPS2.elf
     // with a blank card in slot 2)
@@ -852,6 +882,8 @@ const char *ripps2ExitPath(char *buf, int size)
 {
     (void)buf;
     (void)size;
+    if (!gExitPath[0] && igrBootLoader[0])
+        return igrBootLoader;
     return gExitPath[0] != '\0' && strcmp(gExitPath, "Browser") && exitLoadable() ? gExitPath : "Browser";
 }
 
