index 0000000..4dd8832
--- /dev/null
+++ b/include/elfprobe.h
@@ -0,0 +1,8 @@
+#ifndef ELFPROBE_H
+#define ELFPROBE_H
+
+/* Read ps2-packer LZMA payloads for capability inspection only. Never execute
+ * them or write to their virtual addresses. The caller frees the result. */
+unsigned char *elfProbeUnpack(const char *path, int *length);
+
