diff --git a/src/elfprobe.c b/src/elfprobe.c
new file mode 100644
index 0000000..295dd04
--- /dev/null
+++ b/src/elfprobe.c
@@ -0,0 +1,119 @@
+#include "elfprobe.h"
+#include <fcntl.h>
+#include <unistd.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <lzma.h>
+
+#define PROBE_LIMIT (8 * 1024 * 1024u)
+
+static uint32_t probe32(const unsigned char *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/* Map only file-backed PT_LOAD bytes. ELF addresses are untrusted metadata. */
+static int probeOffset(const unsigned char *b, size_t size, uint32_t address, size_t need, size_t *offset)
+{
+    size_t phoff = probe32(b + 28), entsize = b[42] | b[43] << 8;
+    unsigned int count = b[44] | b[45] << 8, i;
+    if (entsize < 32 || count > 32 || phoff > size || count > (size - phoff) / entsize)
+        return 0;
+    for (i = 0; i < count; i++) {
+        const unsigned char *p = b + phoff + i * entsize;
+        size_t start = probe32(p + 4), bytes = probe32(p + 16);
+        uint32_t base = probe32(p + 8);
+        if (probe32(p) != 1 || address < base || address - base > bytes)
+            continue;
+        if (need > bytes - (address - base) || start > size || bytes > size - start)
+            continue;
+        *offset = start + (address - base);
+        return 1;
+    }
+    return 0;
+}
+
+unsigned char *elfProbeUnpack(const char *path, int *length)
+{
+    unsigned char *packed = NULL, *plain = NULL;
+    size_t size, at, header, capacity = 0, used = 0, readSize = 0;
+    unsigned int sections, i;
+    int fd = open(path, O_RDONLY);
+    off_t end;
+    *length = 0;
+    if (fd < 0)
+        return NULL;
+    end = lseek(fd, 0, SEEK_END);
+    if (end < 52 || end > PROBE_LIMIT || lseek(fd, 0, SEEK_SET) < 0)
+        goto done;
+    size = (size_t)end;
+    packed = malloc(size);
+    if (packed == NULL)
+        goto done;
+    while (readSize < size) {
+        int got = read(fd, packed + readSize, size - readSize);
+        if (got <= 0)
+            goto done;
+        readSize += got;
+    }
+    if (memcmp(packed, "\177ELF\1\1\1", 7) || packed[16] != 2 || packed[17] != 0 ||
+        packed[18] != 8 || packed[19] != 0 || probe32(packed + 24) < 28)
+        goto done;
+    /* ps2-packer's stub places the signature and payload pointer 28 bytes
+     * before its entry. Both merged and separate PT_LOAD layouts are valid. */
+    if (!probeOffset(packed, size, probe32(packed + 24) - 28, 8, &at) || memcmp(packed + at, "LZMA", 4))
+        goto done;
+    if (!probeOffset(packed, size, probe32(packed + at + 4), 8, &header))
+        goto done;
+    sections = probe32(packed + header + 4);
+    if (!sections || sections > 32)
+        goto done;
+    at = header + 8;
+    for (i = 0; i < sections; i++) {
+        size_t output, compressed;
+        if (at > size || size - at < 16)
+            goto done;
+        output = probe32(packed + at);
+        compressed = probe32(packed + at + 12);
+        at += 16;
+        if (!output || output >= PROBE_LIMIT - capacity || compressed < 6 || compressed > size - at)
+            goto done;
+        capacity += output + 1; // separate sections so literals cannot straddle them
+        at = (at + compressed + 3) & ~(size_t)3;
+    }
+    plain = malloc(capacity);
+    if (plain == NULL)
+        goto done;
+    at = header + 8;
+    for (i = 0; i < sections; i++) {
+        size_t output = probe32(packed + at), compressed = probe32(packed + at + 12);
+        size_t inPos = 0, outPos = 0;
+        lzma_filter filters[2] = {{LZMA_FILTER_LZMA1, NULL}, {LZMA_VLI_UNKNOWN, NULL}};
+        lzma_ret result;
+        at += 16;
+        result = lzma_properties_decode(&filters[0], NULL, packed + at, 5);
+        if (result == LZMA_OK && ((lzma_options_lzma *)filters[0].options)->dict_size <= PROBE_LIMIT)
+            result = lzma_raw_buffer_decode(filters, NULL, packed + at + 5, &inPos, compressed - 5,
+                                            plain + used, &outPos, output);
+        else
+            result = LZMA_DATA_ERROR;
+        lzma_filters_free(filters, NULL);
+        if (result != LZMA_OK || inPos != compressed - 5 || !outPos)
+            goto done;
+        /* Older ps2-packer versions advertise the untrimmed size. Accept a
+         * shorter, properly terminated stream; never read its unwritten tail. */
+        used += outPos;
+        plain[used++] = 0xff;
+        at = (at + compressed + 3) & ~(size_t)3;
+    }
+    *length = (int)used;
+done:
+    close(fd);
+    free(packed);
+    if (!*length) {
+        free(plain);
+        plain = NULL;
+    }
+    return plain;
+}
