+void ripps2ArtDownload(void)
+{
+    if (!bdmIsUDPBDLoaded() && (udpfsGetModulesLoaded() || gNetworkProtocol == NET_PROTO_UDPFS)) {
+        artDownloadStaged();
+        return;
+    }
+    unsigned char *body = NULL, *rgb = NULL;
+    const char *conflict = artNetworkConflict();
+
+    if (conflict != NULL) {
+        guiMsgBox(conflict, 0, NULL);
+        return;
+    }
+
+    artDone = artGot = artMissing = artFailed = 0;
+    artLine[0] = artLine2[0] = '\0';
+    artCount = 0;
+    artTargets = (art_target_t *)malloc(sizeof(art_target_t) * ART_MAX_GAMES);
+    body = (unsigned char *)malloc(ART_MAX_BYTES);
+    rgb = (unsigned char *)malloc(ART_HD_W * ART_HD_H * 3); // either size
+    if (artTargets == NULL || body == NULL || rgb == NULL) {
+        free(artTargets);
+        free(body);
+        free(rgb);
+        artTargets = NULL;
+        guiMsgBox(_t("Not enough memory for the cover download."), 0, NULL);
+        return;
+    }
+
+    artStage = _t("Looking for games without a cover...");
+    artDraw();
+    ioBlockOps(1); // the lists hold still while they are read
+    artCollect(-1);
+    ioBlockOps(0);
+    if (artCount == 0) {
+        free(artTargets);
+        free(body);
+        free(rgb);
+        artTargets = NULL;
+        guiMsgBox(_t("Every game in your started lists already has a cover. Start a drive's list first to look at its games."), 0, NULL);
+        return;
+    }
+
+    // build 125: the size, HD first; a game with a cover keeps it either way
+    {
+        int pick;
+        guiMsgBoxStartOption(_t("STANDARD"));
+        pick = guiMsgBox(_t("Download the covers in HD (280 x 400)? Sharper on an HD screen, about 70 KB each. START: Standard (140 x 200, as Open PS2 Loader's), about 20 KB each. A game that already has a cover keeps it."),
+                         1, NULL);
+        if (pick == 0) {
+            free(artTargets);
+            free(body);
+            free(rgb);
+            artTargets = NULL;
+            return;
+        }
+        artCovW = pick == 2 ? ART_STD_W : ART_HD_W;
+        artCovH = pick == 2 ? ART_STD_H : ART_HD_H;
+    }
+
+    artStage = _t("Starting the network...");
+    artDraw();
+    if (netLoadInitModules(NET_PROTO_SMB) != 0) {
+        free(artTargets);
+        free(body);
+        free(rgb);
+        artTargets = NULL;
+        // A background source startup may have claimed the NIC since entry.
+        conflict = artNetworkConflict();
+        guiMsgBox(conflict != NULL ? conflict : _t("The network did not start. Check the cable, and the IP settings on this page."), 0, NULL);
+        return;
+    }
+
+    artDownloadTargets(body, rgb, NULL, NULL);
     free(body);
     free(rgb);
     free(artTargets);
diff --git a/src/ripps2artjob.c b/src/ripps2artjob.c
new file mode 100644
--- /dev/null
+++ b/src/ripps2artjob.c
@@ -0,0 +1,258 @@
+/* Durable UDPFS artwork staging. No network-stack or GUI dependencies. */
+#include "include/ripps2artjob.h"
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <errno.h>
+
+typedef struct {
+    char magic[8];
+    uint32_t bytes, hash;
+} art_receipt_t;
+
+static uint32_t jobHash(const void *data, size_t size)
+{
+    const unsigned char *p = data;
+    uint32_t h = 2166136261u;
+    while (size--) h = (h ^ *p++) * 16777619u;
+    return h;
+}
+
+static int jobReadExact(const char *path, void *data, size_t size)
+{
+    FILE *f = fopen(path, "rb");
+    int ok;
+    if (!f) return 0;
+    ok = fread(data, 1, size, f) == size && fgetc(f) == EOF && !ferror(f);
+    if (fclose(f) != 0) ok = 0;
+    return ok;
+}
+
+static int jobWriteExact(const char *path, const void *data, size_t size)
+{
+    FILE *f = fopen(path, "wb");
+    size_t done = 0;
+    if (!f) return 0;
+    while (done < size) {
+        size_t n = fwrite((const unsigned char *)data + done, 1, size - done, f);
+        if (!n) break;
+        done += n;
+    }
+    int ok = done == size && !ferror(f);
+    if (fclose(f) != 0) ok = 0;
+    return ok;
+}
+
+static int jobParents(const char *path)
+{
+    char dir[512];
+    if (strlen(path) >= sizeof(dir)) return 0;
+    strcpy(dir, path);
+    for (char *p = dir; *p; p++) {
+        if (*p != '/' || p == dir || p[-1] == ':') continue;
+        *p = 0;
+        struct stat st;
+        if (mkdir(dir, 0777) != 0 && (stat(dir, &st) != 0 || !S_ISDIR(st.st_mode))) return 0;
+        *p = '/';
+    }
+    return 1;
+}
+
+static int jobTargetValid(const art_job_target_t *t)
+{
+    /* Current UDPFS sources use the share root. Restrict persisted write targets
+       to ART/<disc-id>_COV, including the server's exact ART capitalization. */
+    if (!memchr(t->serial, 0, sizeof(t->serial)) || !memchr(t->path, 0, sizeof(t->path)) ||
+        !memchr(t->title, 0, sizeof(t->title)) || strlen(t->serial) != 10 || strlen(t->path) != 26)
+        return 0;
+    if (strncmp(t->path, "udpfs:/", 7) || (t->path[7] != 'A' && t->path[7] != 'a') ||
+        (t->path[8] != 'R' && t->path[8] != 'r') || (t->path[9] != 'T' && t->path[9] != 't') ||
+        t->path[10] != '/' || t->serial[4] != '-' || strcmp(t->path + 22, "_COV")) return 0;
+    for (int i = 0; i < 4; i++) if (t->serial[i] < 'A' || t->serial[i] > 'Z') return 0;
+    for (int i = 5; i < 10; i++) if (t->serial[i] < '0' || t->serial[i] > '9') return 0;
+    char key[32];
+    snprintf(key, sizeof(key), "%.4s_%.3s.%.2s_COV", t->serial, t->serial + 5, t->serial + 8);
+    return !strcmp(t->path + 11, key);
+}
+
+static int jobValid(const art_job_t *job)
+{
+    if (memcmp(job->magic, "R2ART01", 8) || !job->generation || !job->count || job->count > ART_JOB_MAX ||
+        !((job->width == 280 && job->height == 400) || (job->width == 140 && job->height == 200)) ||
+        !memchr(job->token, 0, sizeof(job->token)) || strlen(job->token) != 16 ||
+        job->checksum != jobHash(job, offsetof(art_job_t, checksum))) return 0;
+    for (int i = 0; i < 16; i++)
+        if (!((job->token[i] >= '0' && job->token[i] <= '9') || (job->token[i] >= 'a' && job->token[i] <= 'f'))) return 0;
+    for (unsigned int i = 0; i < job->count; i++) if (!jobTargetValid(&job->targets[i])) return 0;
+    return 1;
+}
+
+art_job_t *artJobLoad(const char *root)
+{
+    art_job_t *best = NULL, *next = malloc(sizeof(*next));
+    char path[256];
+    if (!next) return NULL;
+    for (int slot = 0; slot < 2; slot++) {
+        snprintf(path, sizeof(path), "%s/job%d.bin", root, slot);
+        if (jobReadExact(path, next, sizeof(*next)) && jobValid(next) &&
+            (!best || next->generation > best->generation)) {
+            art_job_t *swap = best;
+            best = next;
+            next = swap ? swap : malloc(sizeof(*next));
+            if (!next) break;
+        }
+    }
+    free(next);
+    return best;
+}
+
+int artJobCreate(const char *root, art_job_t *job, const art_job_target_t *targets,
+                 int count, int width, int height, uint32_t seed)
+{
+    char path[256];
+    art_job_t *previous;
+    uint32_t generation;
+    if (count <= 0 || count > ART_JOB_MAX || strlen(root) > 120) return 0;
+    previous = artJobLoad(root);
+    generation = previous ? previous->generation + 1 : 1;
+    free(previous);
+    if (!generation) return 0;
+    memset(job, 0, sizeof(*job));
+    memcpy(job->magic, "R2ART01", 8);
+    job->generation = generation;
+    job->count = count;
+    job->width = width;
+    job->height = height;
+    memcpy(job->targets, targets, count * sizeof(*targets));
+    /* An existing directory is never reused, including after lost manifests. */
+    int made = 0;
+    for (unsigned int n = 0; n < 10000; n++) {
+        snprintf(job->token, sizeof(job->token), "%08x%08x", (unsigned int)seed, (unsigned int)(generation + n));
+        snprintf(path, sizeof(path), "%s/%s/placeholder", root, job->token);
+        char dir[256];
+        snprintf(dir, sizeof(dir), "%s/%s", root, job->token);
+        struct stat st;
+        if (!stat(dir, &st)) continue;
+        if (!jobParents(path)) return 0;
+        made = 1;
+        break;
+    }
+    if (!made) return 0;
+    job->checksum = jobHash(job, offsetof(art_job_t, checksum));
+    if (!jobValid(job)) return 0;
+    snprintf(path, sizeof(path), "%s/job%u.bin", root, (unsigned int)(generation & 1));
+    if (!jobWriteExact(path, job, sizeof(*job))) return 0;
+    art_job_t *check = artJobLoad(root);
+    int ok = check && !memcmp(check, job, sizeof(*job));
+    free(check);
+    return ok;
+}
+
+int artJobStagePath(const char *root, const art_job_t *job, int index, char *out, int size)
+{
+    if (index < 0 || (unsigned int)index >= job->count || !jobTargetValid(&job->targets[index])) return 0;
+    int n = snprintf(out, size, "%s/%s/%s.png", root, job->token, job->targets[index].path + 7);
+    return n >= 0 && n < size;
+}
+
+static int jobReceiptPath(const char *root, const art_job_t *job, int index, char *out, int size)
+{
+    int n = snprintf(out, size, "%s/%s/%d.ok", root, job->token, index);
+    return n >= 0 && n < size;
+}
+
+int artJobRead(const char *root, const art_job_t *job, int index, unsigned char *data, int capacity)
+{
+    char path[512];
+    art_receipt_t receipt;
+    if (!jobReceiptPath(root, job, index, path, sizeof(path)) || !jobReadExact(path, &receipt, sizeof(receipt)) ||
+        memcmp(receipt.magic, "R2PNG01", 8) || !receipt.bytes || receipt.bytes > ART_JOB_BYTES ||
+        receipt.bytes > (unsigned int)capacity || !artJobStagePath(root, job, index, path, sizeof(path)) ||
+        !jobReadExact(path, data, receipt.bytes) || jobHash(data, receipt.bytes) != receipt.hash) return 0;
+    return receipt.bytes;
+}
+
+int artJobStore(const char *root, const art_job_t *job, int index, const unsigned char *data, int size)
+{
+    char path[512];
+    art_receipt_t receipt = {{0}, 0, 0};
+    if (size < 8 || size > ART_JOB_BYTES || memcmp(data, "\x89PNG\r\n\x1a\n", 8) ||
+        !artJobStagePath(root, job, index, path, sizeof(path)) || !jobParents(path)) return 0;
+    if (!jobWriteExact(path, data, size)) return 0;
+    /* Read back before publishing the receipt. A crash before it is retryable. */
+    FILE *f = fopen(path, "rb");
+    unsigned char block[2048];
+    int ok = f != NULL, offset = 0;
+    while (ok && offset < size) {
+        int n = size - offset < (int)sizeof(block) ? size - offset : (int)sizeof(block);
+        ok = fread(block, 1, n, f) == (size_t)n && !memcmp(block, data + offset, n);
+        offset += n;
+    }
+    if (f && fclose(f) != 0) ok = 0;
+    if (!ok) return 0;
+    memcpy(receipt.magic, "R2PNG01", 8);
+    receipt.bytes = size;
+    receipt.hash = jobHash(data, size);
+    return jobReceiptPath(root, job, index, path, sizeof(path)) && jobWriteExact(path, &receipt, sizeof(receipt));
+}
+
+static void jobServerMarker(const art_job_t *job, char *path, int size)
+{
+    snprintf(path, size, "udpfs:/RIPPS2/artwork-%s.job", job->token);
+}
+
+int artJobSameServer(const art_job_t *job)
+{
+    char path[128], token[24];
+    jobServerMarker(job, path, sizeof(path));
+    return jobReadExact(path, token, sizeof(token)) && !memcmp(token, job->token, sizeof(token));
+}
+
+int artJobMarkServer(const art_job_t *job)
+{
+    char path[128];
+    jobServerMarker(job, path, sizeof(path));
+    return jobParents(path) && jobWriteExact(path, job->token, sizeof(job->token)) && artJobSameServer(job);
+}
+
+/* 0 missing, 1 identical, 2 proper prefix, 3 different contents, 4 IO error. */
+static int jobCompare(const char *path, const unsigned char *data, int size)
+{
+    unsigned char block[2048];
+    FILE *f = fopen(path, "rb");
+    int done = 0, result = 3;
+    if (!f) return errno == ENOENT ? 0 : 4;
+    while (done < size) {
+        int want = size - done < (int)sizeof(block) ? size - done : (int)sizeof(block);
+        size_t n = fread(block, 1, want, f);
+        if (ferror(f)) { result = 4; goto end; }
+        if (memcmp(block, data + done, n)) goto end;
+        done += n;
+        if (!n) { result = 2; goto end; }
+    }
+    if (fgetc(f) == EOF && !ferror(f)) result = 1;
+end:
+    if (fclose(f) != 0) result = 4;
+    return result;
+}
+
+int artJobDeliver(const char *root, const art_job_t *job, int index, unsigned char *data, int capacity)
+{
+    char dest[272], pending[320], token[24];
+    int size = artJobRead(root, job, index, data, capacity);
+    if (!size || !artJobSameServer(job)) return 0;
+    snprintf(dest, sizeof(dest), "%s.png", job->targets[index].path);
+    snprintf(pending, sizeof(pending), "%s.%s.pending", dest, job->token);
+    int existing = jobCompare(dest, data, size);
+    if (existing == 4) return 0;
+    if (existing == 1) { remove(pending); return 1; }
+    if (existing != 0 && !(existing == 2 && jobReadExact(pending, token, sizeof(token)) &&
+                          !memcmp(token, job->token, sizeof(token)))) return 2;
+    if (!jobParents(dest) || !jobWriteExact(pending, job->token, sizeof(job->token)) ||
+        !jobReadExact(pending, token, sizeof(token)) || memcmp(token, job->token, sizeof(token))) return 0;
+    if (!jobWriteExact(dest, data, size) || jobCompare(dest, data, size) != 1) return 0;
+    remove(pending);
+    return 1;
+}
