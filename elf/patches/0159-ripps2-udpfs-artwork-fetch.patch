+#ifndef RIPPS2_ART_JOB_H
+#define RIPPS2_ART_JOB_H
+
+#include <stdint.h>
+
+#define ART_JOB_MAX 512
+#define ART_JOB_BYTES (1024 * 1024)
+typedef struct {
+    char serial[16];
+    char path[256]; /* original destination, without .png */
+    char title[64];
+} art_job_target_t;
+
+typedef struct {
+    char magic[8];
+    uint32_t generation, count, width, height;
+    char token[24];
+    art_job_target_t targets[ART_JOB_MAX];
+    uint32_t checksum;
+} art_job_t;
+
+/* root is a private staging directory on the selected MMCE card. Manifests
+   alternate between two checked slots; image receipts are independently checked.
+   Callers serialize writes with ioWriteBegin and retain the selected card root. */
+art_job_t *artJobLoad(const char *root);
+int artJobCreate(const char *root, art_job_t *job, const art_job_target_t *targets,
+                 int count, int width, int height, uint32_t seed);
+int artJobStagePath(const char *root, const art_job_t *job, int index, char *out, int size);
+int artJobRead(const char *root, const art_job_t *job, int index, unsigned char *data, int capacity);
+int artJobStore(const char *root, const art_job_t *job, int index, const unsigned char *data, int size);
+/* Identity marker is written while the original share is still mounted. */
+int artJobMarkServer(const art_job_t *job);
+int artJobSameServer(const art_job_t *job);
+/* 1 copied/already identical, 2 existing artwork preserved, 0 failed.
+   Always retains the MMCE file. No server rename operation is required. */
+int artJobDeliver(const char *root, const art_job_t *job, int index, unsigned char *data, int capacity);
+
+#endif
