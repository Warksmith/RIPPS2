+// ---------------------------------------------------------------- the run
+static void artDownloadStaged(void)
+{
+    const char *cards[] = {_t("MMCE card 1"), _t("MMCE card 2")};
+    const char *jobs[] = {_t("Resume staged artwork"), _t("Start a new artwork job")};
+    const char *actions[] = {_t("Download missing files"), _t("Copy completed files to UDPFS")};
+    char root[128], message[512];
+    art_job_t *job = NULL;
+    unsigned char *body = NULL, *rgb = NULL;
+    int session = 0, transferOnly = 0, delivered = 0, preserved = 0, failed = 0;
+    int card = ripps2PickList(cards, 2);
+    if (card < 0) return;
+    snprintf(root, sizeof(root), "mmce%d:/RIPPS2/ARTWORK", card);
+    mmceLoadModules();
+    job = artJobLoad(root);
+    if (job != NULL) {
+        int choice = ripps2PickList(jobs, 2);
+        if (choice < 0) goto done;
+        if (choice == 1) { free(job); job = NULL; }
+        else {
+            choice = ripps2PickList(actions, 2);
+            if (choice < 0) goto done;
+            transferOnly = choice == 1;
+        }
+    }
+    artDone = artGot = artMissing = artFailed = artCount = 0;
+    artLine[0] = artLine2[0] = 0;
+    if (job == NULL) {
+        if (!gEnableWrite) {
+            guiMsgBox(_t("Enable writes before creating an artwork job."), 0, NULL);
+            goto done;
+        }
+        artTargets = calloc(ART_MAX_GAMES, sizeof(*artTargets));
+        if (!artTargets) goto memory;
+        artStage = _t("Looking for missing UDPFS covers...");
+        artDraw();
+        ioBlockOpsTimed(1, 20);
+        if (ioHasPendingRequests()) {
+            ioBlockOps(0);
+            guiMsgBox(_t("The library is busy. Try the artwork download again after it finishes loading."), 0, NULL);
+            goto done;
+        }
+        artCollect(UDPFS_MODE);
+        ioBlockOps(0);
+        // This job belongs to exactly one UDPFS share, never to a local source.
+        int count = 0;
+        for (int i = 0; i < artCount; i++)
+            if (!strncmp(artTargets[i].path, "udpfs:/", 7)) artTargets[count++] = artTargets[i];
+        artCount = count;
+        if (!count) {
+            guiMsgBox(_t("No missing covers in the current UDPFS list. Start or refresh that list first."), 0, NULL);
+            goto done;
+        }
+        guiMsgBoxStartOption(_t("STANDARD"));
+        int size = guiMsgBox(_t("Download HD covers to MMCE (280 x 400)? START: Standard (140 x 200). Existing server covers are kept."), 1, NULL);
+        if (!size) goto done;
+        job = calloc(1, sizeof(*job));
+        if (!job) goto memory;
+        int ok = 0;
+        if (ioWriteBegin()) {
+            ok = artJobCreate(root, job, artTargets, count, size == 2 ? ART_STD_W : ART_HD_W,
+                              size == 2 ? ART_STD_H : ART_HD_H, (unsigned int)GetTimerSystemTime());
+            ioWriteEnd();
+        }
+        free(artTargets);
+        artTargets = NULL;
+        if (!ok) {
+            guiMsgBox(_t("Could not save the artwork job. Check the selected MMCE card and its free space. The network has not been switched."), 0, NULL);
+            goto done;
+        }
+        // Failure is allowed for a read-only server: manual export still works.
+        if (ioWriteBegin()) { artJobMarkServer(job); ioWriteEnd(); }
+    }
+    if (!gEnableWrite) {
+        guiMsgBox(_t("Enable writes before downloading or copying staged artwork."), 0, NULL);
+        goto done;
+    }
+    artTargets = job->targets;
+    artCount = job->count;
+    artCovW = job->width;
+    artCovH = job->height;
+    body = malloc(ART_MAX_BYTES);
+    rgb = malloc(ART_HD_W * ART_HD_H * 3);
+    if (!body || !rgb) goto memory;
+    if (!transferOnly && !guiMsgBox(_t("The network will restart while covers download to MMCE. UDPFS returns afterward. Keep this card inserted; completed downloads can be resumed or copied from the card on a PC. Continue?"), 1, NULL)) goto done;
+    artStage = _t("Preparing artwork transfer...");
+    artDraw();
+    if (!ripps2ArtSessionBegin()) {
+        guiMsgBox(_t("The library is busy. The network was not switched. Try again after current activity finishes."), 0, NULL);
+        goto done;
+    }
+    session = 1;
+    // Probe the same card/job after reset, before making any download writes.
+    art_job_t *check = artJobLoad(root);
+    int sameCard = check && !memcmp(check, job, sizeof(*job));
+    free(check);
+    if (!sameCard) {
+        snprintf(message, sizeof(message), "%s", _t("The staged job is not readable after restarting MMCE. Downloads remain on the original card."));
+        goto restore;
+    }
+    if (!transferOnly) {
+        artStage = _t("Starting Internet access...");
+        artDraw();
+        if (netLoadInitModules(NET_PROTO_SMB) != 0) {
+            snprintf(message, sizeof(message), _t("Internet networking did not start (code %d). Check cable, IP, gateway and DNS settings. The MMCE job is saved."), gNetworkStartup);
+            goto restore;
+        }
+        artDownloadTargets(body, rgb, job, root);
+        artStage = _t("Restoring UDPFS...");
+        artDraw();
+        ripps2ArtSessionReset();
+    }
+    // Deliberately keep automatic source startup blocked during the copy.
+    if (!udpfsEnsureReady(5000)) {
+        snprintf(message, sizeof(message), _t("UDPFS did not reconnect. Keep the staged artwork at %s/%s. Resume the job to copy it later."), root, job->token);
+        goto restore;
+    }
+    if (!transferOnly && !guiMsgBox(_t("Copy completed covers from MMCE to the original UDPFS share now? MMCE copies are kept. Choose No to copy the staged ART folder on a PC later."), 1, NULL)) {
+        snprintf(message, sizeof(message), _t("Staged artwork: %s/%s. Copy its ART folder into the original server library. Existing covers are unchanged."), root, job->token);
+        goto restore;
+    }
+    if (!artJobSameServer(job)) {
+        snprintf(message, sizeof(message), _t("The original share marker was not found. No server files were written. Copy the artwork manually from %s/%s, or reconnect the original server and resume."), root, job->token);
+        goto restore;
+    }
+    artStage = _t("Copying and verifying covers on UDPFS...");
+    for (int i = 0; i < artCount; i++) {
+        artDone = i;
+        snprintf(artLine, sizeof(artLine), "%s", job->targets[i].title);
+        artDraw();
+        if (artCancelled()) break;
+        if (!artJobRead(root, job, i, body, ART_MAX_BYTES)) continue;
+        int result = artJobDeliver(root, job, i, body, ART_MAX_BYTES);
+        if (result == 1) {
+            char path[272];
+            delivered++;
+            snprintf(path, sizeof(path), "%s.png", job->targets[i].path);
+            ripps2ArtPackNoteNew(path);
+        } else if (result == 2) preserved++;
+        else failed++;
+    }
+    snprintf(message, sizeof(message), _t("%d covers verified on UDPFS; %d existing covers kept; %d copy failures. MMCE copies remain at %s/%s."),
+             delivered, preserved, failed, root, job->token);
+restore:
+    ripps2ArtSessionEnd();
+    session = 0;
+    if (!transferOnly) {
+        int used = strlen(message);
+        snprintf(message + used, sizeof(message) - used, _t("\n%d covers ready on MMCE; %d missing from the collection; %d download failures."), artGot, artMissing, artFailed);
+    }
+    guiMsgBox(message, 0, NULL);
+    goto done;
+memory:
+    guiMsgBox(_t("Not enough memory for the cover download."), 0, NULL);
+done:
+    if (session) ripps2ArtSessionEnd();
+    if (artTargets && (!job || artTargets != job->targets)) free(artTargets);
+    artTargets = NULL;
+    free(job);
+    free(body);
+    free(rgb);
+}
+
+static const char *artNetworkConflict(void)
+{
+    // Test resident drivers, not the selected protocol: changing Settings cannot
+    // unload a NIC driver, and a partially started UDPFS chain still owns it.
+    if (udpfsGetModulesLoaded() || bdmIsUDPBDLoaded())
+        return _t("Cover downloads cannot run while UDPFS or UDPBD owns Ethernet. Add covers to the server's ART folder from a PC. For console downloads, disable UDPFS/UDPBD, save settings and restart, then use a local drive or SMB game list.");
+    return NULL;
+}
