--- a/src/opl.c
+++ b/src/opl.c
@@ -5472,6 +5472,72 @@
         sysShutdownDev9();
 }
 
+static int artSessionActive;
+
+void ripps2ArtSessionReset(void)
+{
+    if (!artSessionActive)
+        return;
+    // All source IO is blocked and all artwork/file handles have been closed.
+    // Ordinary shutdown cannot unload either Ethernet driver. The IOP reset can.
+    ethDeinitModules();
+    sysShutdownDev9ForReset();
+    unloadPads();
+    reset();
+    LOG_INIT();
+    padInit(0);
+    for (int tries = 0; tries < 100; tries++) {
+        if (startPads())
+            break;
+        delay(1);
+    }
+    mmceLoadModules();
+}
+
+int ripps2ArtSessionBegin(void)
+{
+    if (artSessionActive || sysIsPccfOwned())
+        return 0;
+    // IO drain uses legacy delay ticks (~250ms); the art drain uses milliseconds.
+    ioBlockOpsTimed(1, 20);
+    if (ioHasPendingRequests() || !cacheCancelPendingImageLoadsTimed(3000)) {
+        ioBlockOps(0);
+        return 0;
+    }
+    if (!ioWriteBegin()) {
+        ioBlockOps(0);
+        return 0;
+    }
+    ioWriteEnd();
+    audioEnd();
+    guiExecDeferredOps();
+    deinitAllSupport(NO_EXCEPTION, IO_MODE_SELECTED_ALL);
+    clearErrorMessage();
+    artSessionActive = 1;
+    ripps2ArtSessionReset();
+    return 1;
+}
+
+void ripps2ArtSessionEnd(void)
+{
+    if (!artSessionActive)
+        return;
+    // A completed transfer already runs on UDPFS. Keep that compatible stack;
+    // a failed/cancelled Internet phase still needs its return reset.
+    if (ethGetModulesLoaded())
+        ripps2ArtSessionReset();
+    artSessionActive = 0;
+    ioBlockOps(0);
+    initAllSupport(1);
+    mixRequestUpdate();
+    cacheInvalidateFailMemo();
+    artIndexInvalidate();
+    audioInit();
+    sfxReload(-1);
+    if (gEnableBGM)
+        bgmStart();
+}
