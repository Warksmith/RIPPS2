diff --git a/src/udpfslist.c b/src/udpfslist.c
new file mode 100644
index 0000000..da9e7f1
--- /dev/null
+++ b/src/udpfslist.c
@@ -0,0 +1,359 @@
+#include "include/opl.h"
+#include "include/udpfslist.h"
+#include "include/folderbrowse.h"
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#define NEWLIB_PORT_AWARE
+#include <fileXio_rpc.h>
+
+int ioScanCancelled(void);
+
+typedef struct
+{
+    unsigned long long bytes, modified;
+    unsigned int mode;
+} udpfs_scan_stat_t;
+
+static void udpfsCopyStat(udpfs_scan_stat_t *st, const iox_stat_t *info)
+{
+    // Keep directory-entry metadata: some decompression servers return zero
+    // sizes/timestamps from OPEN for virtual ISOs, but accurate values in DREAD.
+    st->bytes = ((unsigned long long)info->hisize << 32) | info->size;
+    memcpy(&st->modified, info->mtime, sizeof(st->modified));
+    st->mode = info->mode;
+}
+
+static int udpfsReadStat(const char *path, udpfs_scan_stat_t *st)
+{
+    iox_stat_t info;
+    int result = fileXioGetStat(path, &info);
+    if (result < 0) {
+        errno = -result;
+        return -1;
+    }
+    // EE newlib stat() has a 32-bit off_t. Preserve DVD9 sizes and do not
+    // reject a valid image with EOVERFLOW before the ISO probe can read it.
+    udpfsCopyStat(st, &info);
+    return 0;
+}
+
+typedef struct udpfs_scan_dir
+{
+    char path[256];
+    int media;
+    unsigned long long modified;
+    struct udpfs_scan_dir *next;
+} udpfs_scan_dir_t;
+
+static udpfs_scan_dir_t *udpfsDirectories;
+
+static void udpfsFreeDirectories(udpfs_scan_dir_t *dirs)
+{
+    while (dirs != NULL) {
+        udpfs_scan_dir_t *next = dirs->next;
+        free(dirs);
+        dirs = next;
+    }
+}
+
+void udpfsListReset(void)
+{
+    udpfsFreeDirectories(udpfsDirectories);
+    udpfsDirectories = NULL;
+}
+
+int udpfsListChanged(void)
+{
+    udpfs_scan_dir_t *dir;
+    for (dir = udpfsDirectories; dir != NULL; dir = dir->next) {
+        udpfs_scan_stat_t st;
+        if (udpfsReadStat(dir->path, &st) != 0 || st.modified != dir->modified)
+            return 1;
+    }
+    return 0;
+}
+
+typedef struct udpfs_scan_node
+{
+    base_game_info_t game;
+    udpfs_game_file_t file;
+    struct udpfs_scan_node *next;
+} udpfs_scan_node_t;
+
+typedef struct
+{
+    udpfs_scan_node_t *head;
+    udpfs_scan_dir_t *directories;
+    const base_game_info_t *oldGames;
+    const udpfs_game_file_t *oldFiles;
+    int oldCount, count, browse;
+    const char *sub;
+} udpfs_scan_t;
+
+/* Do not crawl assets, launchers, saves or host metadata as game libraries. */
+static int udpfsSkipDirectory(const char *name)
+{
+    static const char *const skip[] = {
+        "ART", "CFG", "CHT", "VMC", "THM", "LNG", "APPS", "POPS", "EMBER",
+        "AUDIO", "MEDIA", "PADS", "RIPPS2", "neutrino", "LUNA", "nhddl",
+        "System Volume Information", "lost+found"};
+    unsigned int i;
+    if (name[0] == '.' || name[0] == '$')
+        return 1;
+    for (i = 0; i < sizeof(skip) / sizeof(skip[0]); i++)
+        if (!strcasecmp(name, skip[i]))
+            return 1;
+    return 0;
+}
+
+static int udpfsAddEntry(udpfs_scan_t *scan, const char *path, const char *name,
+                         const udpfs_scan_stat_t *st, int media, int folder)
+{
+    udpfs_scan_node_t *node;
+    int i, length = (int)strlen(name), legacy = 0;
+
+    if (folder) {
+        if (length > ISO_GAME_NAME_MAX || strlen(scan->sub) + length + 1 >= FOLDER_SUB_MAX)
+            return 0;
+    } else {
+        /* Neutrino consumes uncompressed sectors. Compressed server aliases
+           such as Title.cso.iso are ISO files here; raw .zso/.cso are not. */
+        if (length < 5 || strcasecmp(name + length - 4, ".iso"))
+            return 0;
+        legacy = length >= 17 && name[4] == '_' && name[8] == '.' && name[11] == '.';
+        length -= legacy ? 16 : 4;
+        if (length > ISO_GAME_NAME_MAX)
+            return 0;
+    }
+
+    /* A shared CD/DVD subfolder is one navigation row. Games are deduplicated
+       by exact path only, never by title or ID (two discs may share either). */
+    for (node = scan->head; node != NULL; node = node->next)
+        if ((folder && node->game.format == GAME_FORMAT_FOLDER && !strcmp(node->game.name, name)) ||
+            (!folder && !strcmp(node->file.path, path)))
+            return 0;
+    node = calloc(1, sizeof(*node));
+    if (node == NULL)
+        return -1;
+    strcpy(node->file.path, path);
+    node->file.bytes = st->bytes;
+    node->file.modified = st->modified;
+    node->game.media = media;
+    node->game.format = folder ? GAME_FORMAT_FOLDER : (legacy ? GAME_FORMAT_OLD_ISO : GAME_FORMAT_ISO);
+    memcpy(node->game.name, name + (legacy ? GAME_STARTUP_MAX : 0), length);
+    if (!folder) {
+        strcpy(node->game.extension, name + strlen(name) - 4);
+        node->game.parts = 1;
+        node->game.sizeMB = (unsigned long long)st->bytes >> 20;
+        if (legacy) {
+            memcpy(node->game.startup, name, GAME_STARTUP_MAX - 1);
+        } else {
+            for (i = 0; i < scan->oldCount; i++)
+                if (!strcmp(scan->oldFiles[i].path, path) &&
+                    scan->oldFiles[i].bytes == node->file.bytes &&
+                    scan->oldFiles[i].modified == node->file.modified &&
+                    scan->oldGames[i].format != GAME_FORMAT_FOLDER)
+                    break;
+            if (i < scan->oldCount)
+                strcpy(node->game.startup, scan->oldGames[i].startup);
+            else if (!sbIsoStartup(path, node->game.startup, sizeof(node->game.startup))) {
+                free(node);
+                return 0; // not a PS2 disc
+            }
+        }
+    }
+    node->next = scan->head;
+    scan->head = node;
+    scan->count++;
+    return 0;
+}
+
+/* In browse mode root CD/DVD contents remain flattened as in OPL, while other
+   folders are browsable from the share root. Without browsing, walk the tree as
+   LUNA does. Depth and path limits bound memory, open handles and cyclic trees. */
+static int udpfsScanDirectory(udpfs_scan_t *scan, const char *path, int media,
+                              int depth, int shareRoot, int containersOnly)
+{
+    int dir = fileXioDopen(path);
+    iox_dirent_t entry;
+    udpfs_scan_dir_t *children = NULL, *childDir;
+    udpfs_scan_stat_t directoryStat;
+    int result = 0;
+    if (dir < 0)
+        return -1;
+    childDir = malloc(sizeof(*childDir));
+    if (childDir == NULL || udpfsReadStat(path, &directoryStat) != 0) {
+        free(childDir);
+        fileXioDclose(dir);
+        return -1;
+    }
+    strcpy(childDir->path, path);
+    childDir->modified = directoryStat.modified;
+    childDir->next = scan->directories;
+    scan->directories = childDir;
+    for (;;) {
+        char child[256];
+        udpfs_scan_stat_t st;
+        int n, container, childMedia = media;
+        if (ioScanCancelled()) {
+            result = -1;
+            break;
+        }
+        n = fileXioDread(dir, &entry);
+        if (n <= 0) {
+            if (n < 0)
+                result = -1;
+            break;
+        }
+        if (entry.name[0] == '.' || strchr(entry.name, '/') || strchr(entry.name, '\\'))
+            continue;
+        container = shareRoot && (!strcasecmp(entry.name, "CD") || !strcasecmp(entry.name, "DVD"));
+        if (containersOnly && !container)
+            continue;
+        n = snprintf(child, sizeof(child), "%s%s%s", path, path[strlen(path) - 1] == '/' ? "" : "/", entry.name);
+        if (n < 0 || n >= (int)sizeof(child))
+            continue;
+        udpfsCopyStat(&st, &entry.stat);
+        if (FIO_S_ISDIR(st.mode)) {
+            int descend = 0;
+            if (udpfsSkipDirectory(entry.name))
+                continue;
+            if (container)
+                childMedia = !strcasecmp(entry.name, "CD") ? SCECdPS2CD : SCECdPS2DVD;
+            if (scan->browse && container) {
+                if (scan->sub[0]) {
+                    n = snprintf(child, sizeof(child), "%s%s%s/%s", path,
+                                 path[strlen(path) - 1] == '/' ? "" : "/", entry.name, scan->sub);
+                    if (n < 0 || n >= (int)sizeof(child))
+                        continue;
+                    if (udpfsReadStat(child, &st) != 0) {
+                        if (errno == ENOENT || errno == ENOTDIR)
+                            continue; // the subfolder need not exist in all three roots
+                        result = -1;
+                        break;
+                    }
+                }
+                descend = 1;
+            } else if (scan->browse) {
+                result = udpfsAddEntry(scan, child, entry.name, &st, childMedia, 1);
+            } else if (depth < FOLDER_DEPTH_MAX) {
+                descend = 1;
+            }
+            if (descend) {
+                childDir = malloc(sizeof(*childDir));
+                if (childDir == NULL)
+                    result = -1;
+                else {
+                    strcpy(childDir->path, child);
+                    childDir->media = childMedia;
+                    childDir->next = children;
+                    children = childDir;
+                }
+            }
+        } else if (FIO_S_ISREG(st.mode) && !containersOnly) {
+            result = udpfsAddEntry(scan, child, entry.name, &st, childMedia, 0);
+        }
+        if (result < 0)
+            break;
+    }
+    if (fileXioDclose(dir) < 0)
+        result = -1;
+    /* The IOP has only eight UDPFS handles, also used by art and ISO probes.
+       Never hold ancestor directories open during recursion. */
+    while ((childDir = children) != NULL) {
+        children = childDir->next;
+        if (result == 0)
+            result = udpfsScanDirectory(scan, childDir->path, childDir->media, depth + 1, 0, 0);
+        free(childDir);
+    }
+    return result;
+}
+
+int udpfsReadList(base_game_info_t **games, udpfs_game_file_t **files, int *count,
+                  const char *prefix, const char *sub, int browse)
+{
+    udpfs_scan_t scan = {0};
+    base_game_info_t *newGames = NULL;
+    udpfs_game_file_t *newFiles = NULL;
+    udpfs_scan_node_t *node;
+    int result, i = 0;
+    scan.oldGames = *games;
+    scan.oldFiles = *files;
+    scan.oldCount = *count;
+    scan.browse = browse;
+    scan.sub = browse && sub != NULL ? sub : "";
+
+    if (scan.sub[0]) {
+        char path[256];
+        udpfs_scan_stat_t st;
+        int n = snprintf(path, sizeof(path), "%s%s", prefix, scan.sub);
+        result = -1;
+        if (n >= 0 && n < (int)sizeof(path)) {
+            if (udpfsReadStat(path, &st) == 0)
+                result = udpfsScanDirectory(&scan, path, SCECdPS2DVD, 0, 0, 0);
+            else if (errno == ENOENT || errno == ENOTDIR)
+                result = 0;
+        }
+        if (result == 0)
+            result = udpfsScanDirectory(&scan, prefix, SCECdPS2DVD, 0, 1, 1);
+    } else {
+        result = udpfsScanDirectory(&scan, prefix, SCECdPS2DVD, 0, 1, 0);
+    }
+    if (result == 0 && scan.count > 0) {
+        newGames = malloc(scan.count * sizeof(*newGames));
+        newFiles = malloc(scan.count * sizeof(*newFiles));
+        if (newGames == NULL || newFiles == NULL)
+            result = -1;
+    }
+    while ((node = scan.head) != NULL) {
+        scan.head = node->next;
+        if (result == 0) {
+            newGames[i] = node->game;
+            newFiles[i++] = node->file;
+        }
+        free(node);
+    }
+    if (result < 0) {
+        free(newGames);
+        free(newFiles);
+        udpfsFreeDirectories(scan.directories);
+        return -1;
+    }
+    udpfsListReset();
+    udpfsDirectories = scan.directories;
+    free(*games);
+    free(*files);
+    *games = newGames;
+    *files = newFiles;
+    *count = scan.count;
+    return scan.count;
+}
+
+int udpfsFilePath(const base_game_info_t *game, const udpfs_game_file_t *file,
+                  const char *name, char *path, int size)
+{
+    const char *slash;
+    int n;
+    if (size <= 0)
+        return 0;
+    path[0] = '\0';
+    if (game->format == GAME_FORMAT_FOLDER)
+        return 0;
+    if (!strcmp(name, game->name))
+        n = snprintf(path, size, "%s", file->path);
+    else {
+        slash = strrchr(file->path, '/');
+        if (slash == NULL || !name[0] || strchr(name, '/') || strchr(name, '\\') || strchr(name, ':') ||
+            !strcmp(name, ".") || !strcmp(name, ".."))
+            return 0;
+        n = snprintf(path, size, "%.*s%s%s%s%s", (int)(slash - file->path + 1), file->path,
+                     game->format == GAME_FORMAT_OLD_ISO ? game->startup : "",
+                     game->format == GAME_FORMAT_OLD_ISO ? "." : "", name, game->extension);
+    }
+    if (n < 0 || n >= size) {
+        path[0] = '\0';
+        return 0;
+    }
+    return 1;
+}
