+#ifndef __UDPFS_LIST_H
+#define __UDPFS_LIST_H
+
+#include "include/supportbase.h"
+
+/* Kept separately from base_game_info_t: do not change the on-disk OPL caches. */
+typedef struct
+{
+    char path[256];
+    unsigned long long bytes;
+    unsigned long long modified;
+} udpfs_game_file_t;
+
+/* Publish games AND their exact server paths together. Any incomplete scan keeps
+   the previous list. No ul.cfg, games.bin or directory creation on the server. */
+int udpfsReadList(base_game_info_t **games, udpfs_game_file_t **files, int *count,
+                  const char *prefix, const char *sub, int browse);
+int udpfsListChanged(void);
+void udpfsListReset(void);
+
+/* Compose a rename in the same directory, retaining legacy ID prefixes. */
+int udpfsFilePath(const base_game_info_t *game, const udpfs_game_file_t *file,
+                  const char *name, char *path, int size);
+
+#endif
diff --git a/modules/network/udpfs_shared/src/udpfs_core.c b/modules/network/udpfs_shared/src/udpfs_core.c
index 497d78a..328dee3 100644
--- a/modules/network/udpfs_shared/src/udpfs_core.c
+++ b/modules/network/udpfs_shared/src/udpfs_core.c
@@ -557,6 +557,33 @@ int udpfs_core_dread(int32_t handle, iox_stat_t *stat, char *name, int name_max)
 /*
  * Get file/directory statistics
  */
+static int udpfs_stat_from_open(const char *path, iox_stat_t *stat)
+{
+    udpfs_msg_open_reply_t *reply = (udpfs_msg_open_reply_t *)g_rx_buf;
+    int32_t handle;
+    int ret;
+
+    /* Some servers implement OPEN/DREAD but return EIO for GETSTAT (including
+     * virtual compressed ISO names). OPEN already carries the needed metadata.
+     * This is read-only, and the temporary handle is closed on every success. */
+    ret = udpfs_core_open(path, 0x0001 /* PS2 O_RDONLY */, 0, path[0] == '\0', &handle);
+    if (ret == -EISDIR)
+        ret = udpfs_core_open(path, 0x0001, 0, 1, &handle);
+    if (ret < 0)
+        return ret;
+
+    memset(stat, 0, sizeof(*stat));
+    stat->mode = reply->mode;
+    stat->size = reply->size;
+    stat->hisize = reply->hisize;
+    memcpy(stat->ctime, reply->ctime, 8);
+    memcpy(stat->mtime, reply->mtime, 8);
+    memcpy(stat->atime, reply->mtime, 8); // OPEN has no access timestamp
+    /* close reuses g_rx_buf: copy the metadata before issuing that request. */
+    ret = udpfs_core_close(handle);
+    return ret < 0 ? ret : (stat->mode != 0 ? 0 : -EIO);
+}
+
 int udpfs_core_getstat(const char *path, iox_stat_t *stat)
 {
     udpfs_msg_getstat_req_t *req = (udpfs_msg_getstat_req_t *)g_tx_buf;
@@ -594,6 +621,10 @@ int udpfs_core_getstat(const char *path, iox_stat_t *stat)
         return -EIO;
     }
 
+    /* Only an explicit server error enables the fallback. Timeouts, a dead
+     * transport and malformed responses above remain failures, never emptiness. */
+    if (reply->result == -EIO || reply->result == -ENOSYS)
+        return udpfs_stat_from_open(path, stat);
     if (reply->result < 0)
         return reply->result;
 
