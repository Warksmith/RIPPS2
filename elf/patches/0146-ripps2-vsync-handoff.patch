+static int vsyncSema = -1;
 // RIPPS2: microseconds the last frame spent asleep waiting for its vsync. Near zero means the frame
-// overran: the vsync's wakeup was already pending, so SleepThread returned at once and every thread
+// overran: the vsync signal was already pending, so the wait returned at once and every thread
 // below the GUI got no CPU this frame (see guiEndFrame).
 unsigned int rmLastSleepUs = 0;
 static int vsync_id = -1;
@@ -191,6 +190,57 @@ void rmStartFrame(void)
 
 unsigned int gRmFrameNo = 0; // RIPPS2 build 115: frames drawn (the hint glyphs' fade compares one frame with the last)
 
+static int rmOnVSync(int cause)
+{
+    if (vsyncSema >= 0) {
+        // Keep only the latest tick, including on kernels that do not enforce max_count.
+        // A pending signal belongs to this semaphore, never to an unrelated thread sleep.
+        iPollSema(vsyncSema);
+        iSignalSema(vsyncSema);
+    }
+
+    ExitHandler();
+    return 0;
+}
+
+static void rmVSyncInit(void)
+{
+    ee_sema_t sema = {0};
+    sema.max_count = 1;
+    sema.init_count = 0;
+    vsyncSema = CreateSema(&sema);
+    if (vsyncSema >= 0) {
+        vsync_id = gsKit_add_vsync_handler(&rmOnVSync);
+        if (vsync_id < 0) {
+            DeleteSema(vsyncSema);
+            vsyncSema = -1;
+        }
+    }
+}
+
+static void rmVSyncEnd(void)
+{
+    // Detach the interrupt before releasing the object it signals (also on video-mode changes).
+    if (vsync_id >= 0) {
+        gsKit_remove_vsync_handler(vsync_id);
+        vsync_id = -1;
+    }
+    if (vsyncSema >= 0) {
+        DeleteSema(vsyncSema);
+        vsyncSema = -1;
+    }
+}
+
+static void rmWaitVSync(void)
+{
+    // The old guiWakeupCount latch could suppress every later interrupt after a lost wakeup,
+    // leaving the handoff fade asleep forever. Let the kernel own the signal and wait together.
+    if (vsyncSema >= 0)
+        WaitSema(vsyncSema);
+    else
+        gsKit_vsync_wait(); // Allocation/handler failure: use the GS polling path, not SleepThread.
+}
+
 void rmEndFrame(void)
 {
     gRmFrameNo++;
