+// Retained only after a successful GameID send. A failed/declined next launch
+// cannot reuse an older launch's card identity.
+static char mmcePrevious[MMCE_RETURN_ARG_SIZE] = MMCE_RETURN_EMPTY;
+
+int mmceReturnNeeded(void)
+{
+    return gMMCEIGRSlot || mmcePrevious[1] != '0' || mmcePrevious[10] != '0';
+}
+
+void mmceReturnArgs(char *args)
+{
+    int slot;
+    memcpy(args, mmcePrevious, sizeof(mmcePrevious));
+    for (slot = 0; slot < 2; slot++) {
+        int at = 1 + slot * MMCE_RETURN_SLOT_SIZE;
+        if (args[at] == '0' && (gMMCEIGRSlot & (1 << slot)))
+            args[at] = '1'; // preserve the explicit IGR boot-card setting
+    }
+}
+
+int mmceGameIDSlot(int vmcSlotMask)
+{
+    char preferred[8];
+    const char *candidates[3];
+    int tried = 0, i;
+    if (!gMMCEEnableGameID || !mmceModLoaded)
+        return -1;
+    mmceGetDeviceRoot(preferred, sizeof(preferred));
+    candidates[0] = preferred;
+    candidates[1] = "mmce0:/";
+    candidates[2] = "mmce1:/";
+    for (i = 0; i < 3; i++) {
+        int slot;
+        if (strlen(candidates[i]) < 5)
+            continue;
+        slot = candidates[i][4] - '0';
+        if (slot < 0 || slot > 1 || ((tried | vmcSlotMask) & (1 << slot)))
+            continue;
+        tried |= 1 << slot;
+        if (fileXioDevctl(candidates[i], 0x1, NULL, 0, NULL, 0) >= 0)
+            return slot;
+    }
+    return -1;
+}
