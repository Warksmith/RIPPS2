     char mmceDevice[sizeof(mmcePrefix)];
+    int previousCard, previousChannel;
 
+    memcpy(mmcePrevious, MMCE_RETURN_EMPTY, sizeof(mmcePrevious));
     mmceGameIdTarget[0] = '\0'; // no stale target: only a send made by THIS call may be settled against
 
+    // Neutrino LUNA switches only after reading its runtime, and arms its IGR
+    // boot-card restore in the same operation. Never switch it here first.
+    if (sysNeutrinoDefersGameID(protectMcPath, startup))
+        return 0;
+
     if (!gMMCEEnableGameID || startup == NULL || startup[0] == '\0')
         return 0;
 
@@ -213,9 +265,23 @@ int mmceSendGameID(const char *startup, const char *protectMcPath, int vmcSlotMa
         }
     }
 
+    // Read before 0x8: GET_CARD/GET_CHANNEL refer to the card currently mounted.
+    // Card zero is ambiguous (boot/named/GameID) on SD2PSX-family firmware.
+    previousCard = fileXioDevctl(mmceDevice, 0x3, NULL, 0, NULL, 0);
+    previousChannel = fileXioDevctl(mmceDevice, 0x5, NULL, 0, NULL, 0);
     if (fileXioDevctl(mmceDevice, 0x8, (void *)startup, (strlen(startup) + 1), NULL, 0) < 0)
         return 0;
 
+    {
+        char record[MMCE_RETURN_SLOT_SIZE + 1];
+        int exact = previousCard > 0 && previousCard < 0xffff &&
+                    previousChannel > 0 && previousChannel <= 0xffff;
+        snprintf(record, sizeof(record), "%c%04x%04x", exact ? '2' : '1',
+                 exact ? previousCard : 0, exact ? previousChannel : 0);
+        memcpy(mmcePrevious + 1 + (mmceDevice[4] - '0') * MMCE_RETURN_SLOT_SIZE,
+               record, MMCE_RETURN_SLOT_SIZE);
+    }
+
     // Remember the slot this send actually targeted -- mmceGameIdSettle() (the MX4SIO pre-launch
     // gate, batch S7) must poll the SAME device, not a guess.
     snprintf(mmceGameIdTarget, sizeof(mmceGameIdTarget), "%s", mmceDevice);
