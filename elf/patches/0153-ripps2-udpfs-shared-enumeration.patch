+    assert(!strcmp(imagePath,"udpfs:/art/SLUS_123.45_COV"));
+    assert(!udpfsGetImage(NULL,"MEDIA",1,"Title","BG",&texture,0));
+    assert(!strcmp(imagePath,"udpfs:/MEDIA/Title_BG"));
+    assert(roots==rootCount && reads==readCount);
+
+    for(int i=0;i<8;i++) { // every ART spelling, including a file masquerading as a directory
+        reset(); rootNames[0]=folderNames[0]=udpfsArtCaseNames[i]; folderState[0]=1;
+        udpfsDiscoverAssets(); complete(); assert(udpfsArtCaseIndex==(unsigned)i);
