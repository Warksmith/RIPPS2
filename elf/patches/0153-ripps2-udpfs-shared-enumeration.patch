+    if(rootOpenFailure) return -EIO;
+    assert(!handles); handles++; rootPosition=0; return 3;
+}
+static int fileXioDread(int fd, iox_dirent_t *entry) {
+    assert(fd==3 && handles); reads++;
+    if(rootPosition==rootReadFailure) return -EIO;
+    if(!rootNames[rootPosition]) return 0;
+    strcpy(entry->name,rootNames[rootPosition++]); return 1;
+}
+static int fileXioDclose(int fd) { assert(fd==3 && handles); handles--; return rootCloseResult; }
+static DIR *opendir(const char *path) {
