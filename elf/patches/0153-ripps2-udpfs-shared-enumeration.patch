 #include <fileXio_rpc.h>
 
 int ioScanCancelled(void);
+
+static udpfs_asset_names_t udpfsAssetNames;
+static int udpfsAssetNamesReady;
+
+static void udpfsAddAssetName(udpfs_asset_names_t *names, const char *name)
+{
+    int i;
+    if (strlen(name) != 3 || (strcasecmp(name, "ART") && strcasecmp(name, "THM") && strcasecmp(name, "LNG")))
+        return;
+    for (i = 0; i < names->count; i++)
+        if (!strcmp(names->names[i], name))
+            return;
+    if (names->count < 24)
+        strcpy(names->names[names->count++], name);
+}
+
+int udpfsTakeAssetNames(udpfs_asset_names_t *names)
+{
+    if (!udpfsAssetNamesReady)
+        return 0;
+    *names = udpfsAssetNames;
+    udpfsAssetNamesReady = 0; // one scan only; retries must see newly added folders
+    return 1;
+}
+
+int udpfsReadAssetNames(const char *prefix, udpfs_asset_names_t *names)
+{
+    udpfs_asset_names_t found = {0};
+    iox_dirent_t entry;
+    int result, dir = fileXioDopen(prefix);
+    if (dir < 0)
+        return 0;
+    while ((result = fileXioDread(dir, &entry)) > 0) {
+        if (ioScanCancelled()) {
+            result = -1;
+            break;
+        }
+        udpfsAddAssetName(&found, entry.name);
+    }
+    if (fileXioDclose(dir) < 0 || result < 0 || ioScanCancelled())
+        return 0;
+    *names = found;
+    return 1;
+}
 
