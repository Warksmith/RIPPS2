+    rootCloseResult=1; udpfsDiscoverAssets(); complete();
+    reset(); rootOpenFailure=1; udpfsDiscoverAssets(); assert(!handles && !themes);
+    rootOpenFailure=0; udpfsDiscoverAssets(); complete();
+    reset(); cancelled=1; udpfsDiscoverAssets(); assert(!handles && !themes);
+    cancelled=0; udpfsDiscoverAssets(); complete();
+    reset(); online=0; udpfsDiscoverAssets(); assert(!roots);
+    online=1; udpfsIomanModLoaded=0; udpfsDiscoverAssets(); assert(!roots);
+    udpfsIomanModLoaded=1; udpfsDiscoverAssets(); complete();
