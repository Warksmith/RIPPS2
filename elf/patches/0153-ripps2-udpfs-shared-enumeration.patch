+"""Compile production root-name sharing and asset discovery; count network passes."""
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+source = (ROOT / 'src/udpfssupport.c').read_text()
+scanner = (ROOT / 'src/udpfslist.c').read_text()
+header = (ROOT / 'include/udpfslist.h').read_text()
+
+
+def function(text, signature):
+    start = text.index(signature)
+    return text[start:text.index('\n}', start) + 2]
+
+
+names_type = header[header.index('typedef struct', header.index('At most eight')):header.index('} udpfs_asset_names_t;') + len('} udpfs_asset_names_t;')]
+shared = scanner[scanner.index('static udpfs_asset_names_t udpfsAssetNames;'):scanner.index('/* A hint cache')]
+table = re.search(r'static const char \*const udpfsArtCaseNames\[8\] = \{.*?\};', source, re.S).group()
+parts = [function(source, sig) for sig in [
+    'static void udpfsSetWaitingForServer(int waiting)\n{',
+    'static void udpfsDiscoverThemes(', 'static void udpfsDiscoverLanguages(',
+    'static int udpfsArtFolderHasFiles(', 'static void udpfsDiscoverArtFolder(',
+    'static void udpfsDiscoverAssets(void)\n{', 'static int udpfsGetImage(']]
+code = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <strings.h>
+#define ripps2Diag(...) ((void)0)
+#define MENU_UPD_DELAY_GENREFRESH 2
+#define UDPFS_MODE_UPDATE_DELAY 300
+typedef struct { int index, position; } DIR;
+typedef struct { int unused; } item_list_t;
+typedef struct { int unused; } GSTEXTURE;
+struct dirent { char d_name[256]; };
+typedef struct { char name[256]; } iox_dirent_t;
+static const char *udpfsPrefix = "udpfs:/";
+static struct { int mode, updateDelay; } udpfsGameList = {13,0};
+static int udpfsIomanModLoaded, udpfsThemesScanned, udpfsLanguagesScanned;
+static int udpfsArtCaseChecked, udpfsWaitingForServer;
+static unsigned int udpfsArtCaseIndex;
+static int online, cancelled, rootOpenFailure, rootReadFailure, rootCloseResult;
+static int roots, reads, handles, closeFailure;
+static int artInvalidations, indexInvalidations, themes, languages;
+static char themePaths[16][128], languagePaths[16][128];
+static const char *rootNames[400];
+static const char *folderNames[24];
+static int folderState[24]; // -2 read error, -1 unavailable, 0 empty, 1 populated
+static DIR dirs[24];
+static struct dirent de;
+static int rootPosition;
+static char imagePath[256];
+static int texDiscoverLoad(GSTEXTURE *texture, const char *path, int id) {
