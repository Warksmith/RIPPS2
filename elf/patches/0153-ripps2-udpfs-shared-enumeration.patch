+    folderState[3]=folderState[4]=-1; udpfsDiscoverAssets();
+    assert(!udpfsThemesScanned && !udpfsLanguagesScanned && udpfsArtCaseChecked);
+    assert(udpfsGameList.updateDelay==MENU_UPD_DELAY_GENREFRESH);
+    folderState[3]=folderState[4]=0; udpfsDiscoverAssets(); complete();
