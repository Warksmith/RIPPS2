@@ -5,21 +5,45 @@
 
 #include "cd_igr_rpc.h"
 
+/* These must outlive a timed-out request: SIF can still complete it while
+ * the caller begins the IOP reset. Never leave its client on a dead stack. */
+static SifRpcClientData_t igrClient __attribute__((aligned(64)));
+static s32 igrPoweroff __attribute__((aligned(64)));
+
+static u32 igrTicks(void)
+{
+    u32 ticks;
+    __asm__ __volatile__("mfc0 %0, $9"
+                         : "=r"(ticks));
+    return ticks;
+}
+
+static int igrWait(u32 start)
+{
+    do {
+        /* COP0 Count keeps running with the game threads/interrupts stopped. */
+        if ((u32)(igrTicks() - start) >= 2 * 294912000u)
+            return -1;
+    } while (SifCheckStatRpc(&igrClient));
+    return 0;
+}
+
 int oplIGRShutdown(int poff)
 {
-    SifRpcClientData_t _igr_cd __attribute__((aligned(64)));
+    u32 start = igrTicks();
     int r;
-    s32 poffData __attribute__((aligned(64)));
-
-    _igr_cd.server = NULL;
-    while ((r = SifBindRpc(&_igr_cd, 0x80000598, 0)) >= 0 && (!_igr_cd.server))
-        nopdelay();
 
-    if (r < 0)
-        return -E_SIF_RPC_BIND;
+    igrClient.server = NULL;
+    do {
+        r = SifBindRpc(&igrClient, 0x80000598, SIF_RPC_M_NOWAIT);
+        if (r < 0 || igrWait(start) < 0)
+            return -E_SIF_RPC_BIND;
+    } while (!igrClient.server);
 
-    *(s32 *)UNCACHED_SEG(&poffData) = poff;
-    if (SifCallRpc(&_igr_cd, 1, SIF_RPC_M_NOWBDC, &poffData, sizeof(poffData), NULL, 0, NULL, NULL) < 0)
+    *(s32 *)UNCACHED_SEG(&igrPoweroff) = poff;
+    if (SifCallRpc(&igrClient, 1, SIF_RPC_M_NOWAIT | SIF_RPC_M_NOWBDC,
+                   &igrPoweroff, sizeof(igrPoweroff), NULL, 0, NULL, NULL) < 0 ||
+        igrWait(start) < 0)
         return -E_SIF_RPC_CALL;
 
     return 0;
