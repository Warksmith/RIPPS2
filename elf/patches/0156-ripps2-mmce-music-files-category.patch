+/* RIPPS2 build 156 (the user, 11/08: a ripped CD track "struggles to play the file on my mmce but can read the song fine from
+   disc"). The music's file was a buffered FILE, so a piece of it reached the drive as stdio's refills, one after another with
+   nothing between them. On an MMCE card each request holds the SIO2 bus (the pads' bus too) for the card's own SD time, and
+   audsrv keeps only ten SPU2 feeds (about 107 ms) on the IOP: while a run of requests held the IOP and the bus, audsrv's ring ran
+   dry and the sound skipped. An Ogg track needs a piece every ~13 s and the skips were rare; a CD .wav (176 KB/s, nine times the
+   bytes) needs one every 1.4 s. The file is now unbuffered, so each read is one request of the size asked for: 32 KB, and on an
+   MMCE card 16 KB (one fileXio piece) with a short gap after each, the pacing the art's MMCE reads have had since build 115. */
+#define BGM_READ_PIECE  (32 * 1024)
+#define BGM_MMCE_PIECE  (16 * 1024)
+#define BGM_MMCE_GAP_US 2000
+
+static FILE *bgmOpenFile(const char *path)
+{
+    FILE *f = fopen(path, "rb");
+
+    if (f != NULL)
+        setvbuf(f, NULL, _IONBF, 0); // build 156: each fread below is one device request
+    return f;
+}
+
+// want bytes from where the file is into dst, in pieces (see above); the bytes read
+static size_t bgmSourceGet(bgm_source_t *src, unsigned char *dst, size_t want)
+{
+    size_t got = 0, piece = src->paced ? BGM_MMCE_PIECE : BGM_READ_PIECE;
+
+    while (got < want) {
+        size_t n = want - got > piece ? piece : want - got, r;
+        if (got > 0 && src->paced)
+            DelayThread(BGM_MMCE_GAP_US); // the pads and audsrv have the bus and the IOP between pieces
+        r = fread(dst + got, 1, n, src->f);
+        got += r;
+        if (r < n)
+            break;
+    }
+    return got;
+}
+
+// build 156: the music's reads in DIAG.TXT (STATUS > SAVE DIAGNOSTICS), so a console run says how fast its drive really gives
+// the music: each file's first piece, then any piece that came slower than CD audio plays (176 KB/s) or took over half a
+// second, a few per file so the ring keeps the rest of the run
+#define BGM_READ_NOTES 12
+static void bgmReadNote(bgm_source_t *src, size_t got, clock_t ticks)
+{
+    unsigned int ms = (unsigned int)(((unsigned long long)ticks * 1000) / CLOCKS_PER_SEC);
+    unsigned int kbs = ms > 0 ? (unsigned int)(((unsigned long long)got * 1000 / 1024) / ms) : 0;
+
+    src->pieces++;
+    if (src->notes >= BGM_READ_NOTES || (src->pieces > 1 && ms < 500 && (ms == 0 || kbs >= 176)))
+        return;
+    src->notes++;
+    ripps2Diag("music read %s: %u KB in %u ms (%u KB/s), piece %d%s", src->path, (unsigned int)(got / 1024), ms, kbs,
+               src->pieces, src->paced ? ", paced" : "");
+}
